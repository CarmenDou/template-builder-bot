{
  "display_information": {
    "name": "template-builder",
    "description": "Give it a GitHub URL and it drafts an InstaCloud template PR",
    "background_color": "#1f2933"
  },
  "features": {
    "bot_user": {
      "display_name": "template-builder",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://REPLACE-ME.compute.instacloud-edge.com/slack/events",
      "bot_events": ["app_mention"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
