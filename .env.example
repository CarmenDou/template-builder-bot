# Slack
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Channel ids the bot answers in. Anywhere else it stays silent.
# This is the only thing between Slack and an agent that can push branches and deploy.
ALLOWED_CHANNELS=C0XXXXXXXXX

# How the bot reaches the agent box
INSTA_API_KEY=insta_
# The InstaCloud project the agent box lives in, and the compute service inside it.
AGENT_PROJECT_ID=00000000-0000-0000-0000-000000000000
AGENT_SERVICE=claude-code

# Offering a PUBLISHED template back to the project it was built from, on request. A CLASSIC token
# with public_repo: fine-grained tokens cannot fork or open a pull request on a repository their
# owner does not own (both answer 403 "Resource not accessible by personal access token").
# Deliberately NOT on the agent box: that scope can write to every public repository its owner can,
# and the box runs whatever a job decides to. Absent, offer_template_upstream refuses and says so.
#
# TWO places, not one, when this runs as hermes' stdio MCP server. Setting the secret on the hermes
# service puts it in that container's environment, which is NOT the same as putting it in this
# process's: hermes launches the server with an explicit env map in ~/.hermes/config.yaml, and a
# name missing from that map is simply absent here. The refusal then reads as "no credential is
# configured", which is true and says nothing about which of the two places is missing it.
#
#   mcpServers:
#     template-jobs:
#       env:
#         GITHUB_PR_TOKEN: ${GITHUB_PR_TOKEN}   # add here too, then restart hermes
#
# GITHUB_PR_TOKEN=ghp_

# Handing a finished draft to the review bots, on request. Member ids only:
# a B or C id posts something that looks like a mention and wakes nobody.
# SLACK_REVIEW_CHANNEL=C0XXXXXXXXX
# SLACK_REVIEW_BOT_IDS=U0XXXXXXXXX
# SLACK_CLAUDE_BOT_ID=U0XXXXXXXXX

# Driving the box over ssh instead of `compute exec`, which caps a command at
# 64KB of argv and 180 seconds. Needs `insta compute ssh <service> --setup` to
# have been run once on this machine, under an interactive login.
# SSH_CONFIG=/data/.hermes/.ssh/config
# SSH_ALIAS=claude-code.insta

# Optional
# INSTA_BIN=insta
# JOB_TIMEOUT_MS=2700000
# POLL_INTERVAL_MS=20000
# PORT=8080
