# Slack
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Channel ids the bot answers in. Anywhere else it stays silent.
# This is the only thing between Slack and an agent that can push branches and deploy.
ALLOWED_CHANNELS=C0XXXXXXXXX

# How the bot reaches the agent box
INSTA_API_KEY=insta_
# The InstaCloud project the agent box lives in, and the compute service inside it.
AGENT_PROJECT_ID=00000000-0000-0000-0000-000000000000
AGENT_SERVICE=claude-code

# Optional
# INSTA_BIN=insta
# JOB_TIMEOUT_MS=2700000
# POLL_INTERVAL_MS=20000
# PORT=8080
